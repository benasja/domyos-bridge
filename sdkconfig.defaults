# ---- Bluetooth: BLE only, NimBLE host --------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set

# Both roles at once: central (to the bike) + peripheral (to the Watch).
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# 1 bike + up to 2 centrals (Watch, plus a spare so a phone can't lock it out).
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3

# Bonding: Just Works, keys persisted in NVS so the Watch reconnects by itself.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=8

CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Domyos Bridge"
CONFIG_BT_NIMBLE_SVC_GAP_APPEARANCE=0x0484

# NimBLE's own logging is very chatty at INFO.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120

# ---- Logging: INFO by default, DEBUG compiled in (enable per tag at runtime)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- Flash (ESP32-C3 Super Mini has 4 MB) ----------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
